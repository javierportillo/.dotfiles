[user]
  name = Javier Portillo
  email = javiermarquezportillo@gmail.com
  signingkey = FD545F5644840F81DFD7C5E82FB60659F7C33AA8
[checkout]
  defaultRemote = origin
[init]
  defaultBranch = main
[core]
  editor = nvim
  pager = delta
[commit]
  template = ~/.config/git/commit_template
  gpgsign = true
[tag]
  gpgSign = true
[pull]
  rebase = false
[push]
  autoSetupRemote = true
  default = current
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
